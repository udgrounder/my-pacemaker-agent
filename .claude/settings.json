{
  "permissions": {
    "allow": [
      "Write(workspace/**)",
      "Edit(workspace/**)",
      "Write(.mpa/runtime/**)",
      "Edit(.mpa/runtime/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.mpa/runtime/hooks/session_start.py --agent claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.mpa/runtime/hooks/code_gate.py --agent claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.mpa/runtime/hooks/dist_sync.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.mpa/runtime/hooks/turn_end.py --agent claude"
          }
        ]
      }
    ]
  }
}
